# Identité publique. Le domaine doit déjà pointer vers l'adresse IPv4 du VPS.
HYDRO_DOMAIN=staging.exemple.com
ACME_EMAIL=administrateur@exemple.com

# Environnement de développement distant sécurisé.
HYDRO_ENVIRONMENT=staging
HYDRO_AUTHENTICATION_REQUIRED=true
HYDRO_LOG_LEVEL=info
HYDRO_WEB_CONCURRENCY=2
HYDRO_BACKGROUND_JOBS_ENABLED=true
HYDRO_WORKER_POLL_SECONDS=1
HYDRO_WORKER_STALE_SECONDS=300

# Remplacer chaque valeur CHANGE_ME avant tout démarrage.
HYDRO_JWT_SECRET=CHANGE_ME_64_CARACTERES_ALEATOIRES
POSTGRES_DB=hydro
POSTGRES_USER=hydro
POSTGRES_PASSWORD=CHANGE_ME_MOT_DE_PASSE_POSTGRES
MINIO_ROOT_USER=hydro
MINIO_ROOT_PASSWORD=CHANGE_ME_MOT_DE_PASSE_MINIO
HYDRO_OBJECT_STORAGE_BUCKET=hydro-reports
HYDRO_S3_REGION=us-east-1

# Seuls Caddy et SSH doivent être publics. Les autres services restent sur la boucle locale.
PUBLIC_BIND_ADDRESS=0.0.0.0
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
WEB_BIND_ADDRESS=127.0.0.1
WEB_HTTP_PORT=5173
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
