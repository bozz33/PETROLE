# API
HYDRO_ENVIRONMENT=development
HYDRO_HOST=0.0.0.0
HYDRO_PORT=8000
HYDRO_LOG_LEVEL=info
HYDRO_DATABASE_URL=postgresql+psycopg://hydro:hydro_dev@localhost:5432/hydro
HYDRO_AUTHENTICATION_REQUIRED=false
HYDRO_JWT_SECRET=development-secret-change-before-production
HYDRO_ACCESS_TOKEN_MINUTES=15
HYDRO_REFRESH_TOKEN_DAYS=7
HYDRO_BACKGROUND_JOBS_ENABLED=false
HYDRO_WORKER_POLL_SECONDS=1
HYDRO_WORKER_STALE_SECONDS=300

# PostgreSQL/PostGIS — valeurs réservées au développement local
POSTGRES_DB=hydro
POSTGRES_USER=hydro
POSTGRES_PASSWORD=hydro_dev
POSTGRES_PORT=5432

# Stockage objet local
MINIO_ROOT_USER=hydro
MINIO_ROOT_PASSWORD=hydro_dev_storage
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
HYDRO_OBJECT_STORAGE_BUCKET=hydro-reports
HYDRO_S3_REGION=us-east-1
