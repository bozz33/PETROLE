# syntax=docker/dockerfile:1.7

FROM python:3.11-slim AS base

# Le venv créé par ``ensurepip`` suit l'image Python et peut embarquer des bibliothèques
# vendues obsolètes. Ces versions corrigent les composants vendus signalés par les scans
# d'image et de dépendances, tout en restant reproductibles.
ARG PIP_VERSION=26.1.2
ARG SETUPTOOLS_VERSION=83.0.0

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /workspace

RUN python -m venv /opt/venv \
    && /opt/venv/bin/python -m pip install --no-cache-dir "pip==${PIP_VERSION}" "setuptools==${SETUPTOOLS_VERSION}" \
    && /usr/local/bin/python -m pip install --no-cache-dir "pip==${PIP_VERSION}" \
    && groupadd --gid 10001 hydro \
    && useradd --uid 10001 --gid hydro --create-home --shell /usr/sbin/nologin hydro

FROM base AS development

COPY pyproject.toml README.md LICENSE ./
COPY apps/api ./apps/api
COPY packages ./packages

RUN --mount=type=cache,target=/root/.cache/pip \
    PIP_NO_CACHE_DIR=0 pip install --editable ".[dev,pandapipes]"

USER hydro

EXPOSE 8000

CMD ["uvicorn", "hydro_api.application:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--reload-dir", "/workspace/apps/api", "--reload-dir", "/workspace/packages"]

FROM base AS build

COPY pyproject.toml README.md LICENSE ./
COPY apps/api ./apps/api
COPY packages ./packages

RUN --mount=type=cache,target=/root/.cache/pip \
    PIP_NO_CACHE_DIR=0 pip wheel --wheel-dir /tmp/wheels .

FROM base AS runtime

ARG HYDRO_BUILD_GIT_SHA=unknown
ARG HYDRO_BUILD_REF=unknown
ARG HYDRO_BUILD_DATE=unknown
ARG HYDRO_DATABASE_MIGRATION_VERSION=8b1f2d6c4e90

ENV HYDRO_BUILD_GIT_SHA=${HYDRO_BUILD_GIT_SHA} \
    HYDRO_BUILD_REF=${HYDRO_BUILD_REF} \
    HYDRO_BUILD_DATE=${HYDRO_BUILD_DATE} \
    HYDRO_DATABASE_MIGRATION_VERSION=${HYDRO_DATABASE_MIGRATION_VERSION}

COPY --from=build /tmp/wheels /tmp/wheels
RUN pip install /tmp/wheels/* \
    # setuptools n'est requis que pour construire/installer le paquet. Le retirer de l'image
    # d'exécution réduit la surface d'attaque et évite d'embarquer ses dépendances vendues.
    && python -m pip uninstall --yes setuptools \
    # L'image Python fournit aussi setuptools hors du venv. Il n'est pas utilisé par Uvicorn
    # ni le worker et doit disparaître du système final pour ne pas conserver de copie vendue.
    && /usr/local/bin/python -m pip uninstall --yes setuptools \
    && rm -rf /tmp/wheels

# Les migrations Alembic sont appliquées dans ce conteneur par les scripts VPS
# (``alembic upgrade head`` depuis le WORKDIR). Le paquet installé expose le code
# de l'API, mais ni ``alembic.ini`` ni ``database/migrations`` ne sont inclus
# dans le wheel : ils doivent donc être copiés explicitement dans l'image finale.
# Le WORKDIR /workspace correspond à la racine attendue par script_location.
COPY alembic.ini ./
COPY database ./database

USER hydro

EXPOSE 8000

CMD ["uvicorn", "hydro_api.application:app", "--host", "0.0.0.0", "--port", "8000"]
